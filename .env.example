# ==============================
# n8n
# ==============================

N8N_VERSION=2.40.5
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Stockholm


# ==============================
# Security
# ==============================

N8N_ENCRYPTION_KEY=CHANGE_ME


# ==============================
# Task Runner
# ==============================

RUNNER_VERSION=2.40.5
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME


# ==============================
# Public URLs
# ==============================

WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# For Cloudflare Quick Tunnel:
# Replace the two values above with the temporary
# https://xxxx.trycloudflare.com URL


# ==============================
# Reverse Proxy
# ==============================

N8N_PROXY_HOPS=1


